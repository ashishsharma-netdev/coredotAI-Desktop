<Window x:Class="CoreDotAI.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CoreDotAI" Height="900" Width="1240" MinHeight="760" MinWidth="1040"
        WindowStartupLocation="CenterScreen" Background="{StaticResource WindowBackground}">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="0,0,0,24">
            <StackPanel>
                <TextBlock Text="CoreDotAI" Foreground="{StaticResource PrimaryText}" FontSize="28" FontWeight="SemiBold"/>
                <TextBlock Text="Your AI-powered interview workspace" Foreground="{StaticResource SecondaryText}" FontSize="13" Margin="0,4,0,0"/>
            </StackPanel>
            <Border DockPanel.Dock="Right" Background="#20283A" CornerRadius="14" Padding="12,7" VerticalAlignment="Center">
                <TextBlock x:Name="HeaderStatusText" Text="● READY" Foreground="#83E0B0" FontSize="11" FontWeight="Bold"/>
            </Border>
        </DockPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{StaticResource PanelBackground}" CornerRadius="18" Padding="24">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0">
                        <TextBlock Text="Live assistant" Foreground="{StaticResource PrimaryText}" FontSize="20" FontWeight="SemiBold"/>
                        <TextBlock Text="Capture audio only when you have permission from everyone involved." Foreground="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,8,0,18"/>
                    </StackPanel>
                    <Border Grid.Row="1" Background="#111722" CornerRadius="12" Padding="16" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="AUDIO SOURCES" Foreground="{StaticResource SecondaryText}" FontSize="11" FontWeight="Bold" Margin="0,0,0,10"/>
                            <CheckBox x:Name="MicrophoneCheckBox" Content="Microphone input" IsChecked="True" Foreground="{StaticResource PrimaryText}" Margin="0,4"/>
                            <CheckBox x:Name="SystemAudioCheckBox" Content="Computer / meeting audio (loopback)" IsChecked="True" Foreground="{StaticResource PrimaryText}" Margin="0,4"/>
                            <CheckBox x:Name="ConsentCheckBox" Foreground="#F2C879" Margin="0,12,0,0" Checked="ConsentCheckBox_Changed" Unchecked="ConsentCheckBox_Changed">
                                <TextBlock Text="I have permission to capture and process this conversation." TextWrapping="Wrap"/>
                            </CheckBox>
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="2" Background="#111722" CornerRadius="12" Padding="16" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="SESSION STATUS" Foreground="{StaticResource SecondaryText}" FontSize="11" FontWeight="Bold"/>
                            <TextBlock x:Name="SessionStatusText" Text="Not recording" Foreground="{StaticResource PrimaryText}" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,4"/>
                            <TextBlock x:Name="SessionDetailsText" Text="Audio files are saved locally. You can transcribe a WAV file after recording." Foreground="{StaticResource SecondaryText}" TextWrapping="Wrap"/>
                            <TextBlock x:Name="OutputFolderText" Foreground="#A4AABC" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="3" Background="#111722" CornerRadius="12" Padding="16">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <DockPanel Grid.Row="0" Margin="0,0,0,10">
                                <TextBlock Text="TRANSCRIPT" Foreground="{StaticResource SecondaryText}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button x:Name="SelectAudioButton" Content="Select WAV" Click="SelectAudioButton_Click" Padding="12,6" Background="#343B4B" Foreground="White" BorderThickness="0" Margin="0,0,8,0"/>
                                    <Button x:Name="TranscribeButton" Content="Transcribe" Click="TranscribeButton_Click" Padding="12,6" Background="{StaticResource AccentBrush}" Foreground="White" BorderThickness="0" IsEnabled="False"/>
                                </StackPanel>
                            </DockPanel>
                            <TextBox x:Name="TranscriptTextBox" Grid.Row="1" IsReadOnly="True" Text="Select a WAV recording, then choose Transcribe. Audio is uploaded only after you explicitly confirm."
                                     Background="#0D131D" Foreground="{StaticResource PrimaryText}" BorderThickness="0" Padding="12" TextWrapping="Wrap" AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"/>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,16,0,0">
                        <Button x:Name="StartButton" Content="Start capture" Click="StartButton_Click" Padding="18,10" Background="{StaticResource AccentBrush}" Foreground="White" BorderThickness="0" IsEnabled="False"/>
                        <Button x:Name="StopButton" Content="Stop capture" Click="StopButton_Click" Padding="18,10" Margin="10,0,0,0" Background="#343B4B" Foreground="White" BorderThickness="0" IsEnabled="False"/>
                    </StackPanel>
                </Grid>
            </Border>
            <Border Grid.Column="2" Background="{StaticResource PanelBackground}" CornerRadius="18" Padding="22">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Workspace" Foreground="{StaticResource PrimaryText}" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock Text="Preparation tools will be enabled in upcoming phases." Foreground="{StaticResource SecondaryText}" Margin="0,8,0,20" TextWrapping="Wrap"/>
                    <Border Background="#111722" CornerRadius="12" Padding="14" Margin="0,0,0,12">
                        <StackPanel><TextBlock Text="RESUME" Foreground="{StaticResource SecondaryText}" FontSize="10"/><TextBlock Text="No resume uploaded" Foreground="{StaticResource PrimaryText}" Margin="0,6,0,0"/></StackPanel>
                    </Border>
                    <Border Background="#111722" CornerRadius="12" Padding="14" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="AI PROVIDER" Foreground="{StaticResource SecondaryText}" FontSize="10" FontWeight="Bold"/>
                            <TextBlock Text="OpenAI transcription" Foreground="{StaticResource PrimaryText}" Margin="0,6,0,10"/>
                            <TextBlock Text="API KEY" Foreground="{StaticResource SecondaryText}" FontSize="10" Margin="0,0,0,6"/>
                            <PasswordBox x:Name="ApiKeyPasswordBox" Padding="9" Background="#0D131D" Foreground="White" BorderBrush="#343B4B" BorderThickness="1"/>
                            <Button x:Name="UseApiKeyButton" Content="Use API Key" Click="UseApiKeyButton_Click" Padding="10,8" Margin="0,10,0,0" Background="{StaticResource AccentBrush}" Foreground="White" BorderThickness="0"/>
                            <TextBlock x:Name="ApiKeyStatusText" Text="No key entered. You can also use OPENAI_API_KEY from Windows." Foreground="{StaticResource SecondaryText}" TextWrapping="Wrap" FontSize="11" Margin="0,8,0,0"/>
                            <TextBlock Text="GOOGLE GEMINI API KEY" Foreground="{StaticResource SecondaryText}" FontSize="10" FontWeight="Bold" Margin="0,16,0,6"/>
                            <PasswordBox x:Name="GeminiApiKeyPasswordBox" Padding="9" Background="#0D131D" Foreground="White" BorderBrush="#343B4B" BorderThickness="1"/>
                            <Button x:Name="UseGeminiApiKeyButton" Content="Use Gemini API Key" Click="UseGeminiApiKeyButton_Click" Padding="10,8" Margin="0,10,0,0" Background="#343B4B" Foreground="White" BorderThickness="0"/>
                            <TextBlock x:Name="GeminiApiKeyStatusText" Text="Gemini key not configured. Used by upcoming AI answer-generation features." Foreground="{StaticResource SecondaryText}" TextWrapping="Wrap" FontSize="11" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#111722" CornerRadius="12" Padding="14" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="GEMINI INTERVIEW COACH" Foreground="{StaticResource SecondaryText}" FontSize="10" FontWeight="Bold"/>
                            <TextBlock Text="Job role (optional)" Foreground="{StaticResource SecondaryText}" FontSize="11" Margin="0,10,0,4"/>
                            <TextBox x:Name="JobRoleTextBox" Padding="8" Background="#0D131D" Foreground="White" BorderBrush="#343B4B" BorderThickness="1" Text=""/>
                            <TextBlock Text="Interview question" Foreground="{StaticResource SecondaryText}" FontSize="11" Margin="0,10,0,4"/>
                            <TextBox x:Name="InterviewQuestionTextBox" Padding="8" Height="76" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="#0D131D" Foreground="White" BorderBrush="#343B4B" BorderThickness="1"/>
                            <TextBlock Text="Relevant experience / details (optional)" Foreground="{StaticResource SecondaryText}" FontSize="11" Margin="0,10,0,4"/>
                            <TextBox x:Name="CandidateContextTextBox" Padding="8" Height="64" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="#0D131D" Foreground="White" BorderBrush="#343B4B" BorderThickness="1"/>
                            <Button x:Name="GenerateAnswerButton" Content="Generate Interview Answer" Click="GenerateAnswerButton_Click" Padding="10,9" Margin="0,12,0,0" Background="{StaticResource AccentBrush}" Foreground="White" BorderThickness="0"/>
                            <TextBlock x:Name="GeminiGenerationStatusText" Text="Enter an interview question, then select Generate Interview Answer." Foreground="{StaticResource SecondaryText}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,6"/>
                            <TextBox x:Name="GeneratedAnswerTextBox" Height="180" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="#0D131D" Foreground="{StaticResource PrimaryText}" BorderThickness="0" Padding="10"/>
                            <Button x:Name="CopyAnswerButton" Content="Copy Answer" Click="CopyAnswerButton_Click" Padding="10,8" Margin="0,8,0,0" Background="#343B4B" Foreground="White" BorderThickness="0" IsEnabled="False"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#20283A" CornerRadius="12" Padding="14">
                        <TextBlock Text="Privacy: capture requires consent. Transcription uploads only the WAV file you select and only after you confirm. API keys are kept in memory for this app session and are not saved to a file. Interview prompts are sent to Google Gemini when you request an answer." Foreground="#C9D0E0" TextWrapping="Wrap" FontSize="12"/>
                    </Border>
                </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
        <TextBlock Grid.Row="2" Text="CoreDotAI • Audio capture + speech-to-text" Foreground="{StaticResource SecondaryText}" FontSize="11" Margin="2,18,0,0"/>
    </Grid>
</Window>