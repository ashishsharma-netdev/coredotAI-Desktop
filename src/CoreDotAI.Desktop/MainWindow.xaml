<Window x:Class="CoreDotAI.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CoreDotAI" Height="760" Width="1180"
        MinHeight="640" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackground}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,24">
            <StackPanel>
                <TextBlock Text="CoreDotAI" Foreground="{StaticResource PrimaryText}"
                           FontSize="28" FontWeight="SemiBold"/>
                <TextBlock Text="Your AI-powered interview workspace"
                           Foreground="{StaticResource SecondaryText}" FontSize="13" Margin="0,4,0,0"/>
            </StackPanel>
            <Border DockPanel.Dock="Right" Background="#20283A" CornerRadius="14"
                    Padding="12,7" VerticalAlignment="Center">
                <TextBlock Text="●  READY" Foreground="#83E0B0" FontSize="11" FontWeight="Bold"/>
            </Border>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource PanelBackground}"
                    CornerRadius="18" Padding="24">
                <StackPanel>
                    <TextBlock Text="Live assistant" Foreground="{StaticResource PrimaryText}"
                               FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock Text="Start a session when you are ready. Audio capture is not active yet."
                               Foreground="{StaticResource SecondaryText}" TextWrapping="Wrap"
                               Margin="0,8,0,24"/>
                    <Border Background="#111722" CornerRadius="12" Padding="18" MinHeight="220">
                        <StackPanel>
                            <TextBlock Text="TRANSCRIPT" Foreground="{StaticResource SecondaryText}"
                                       FontSize="11" FontWeight="Bold"/>
                            <TextBlock Text="Your live transcript will appear here in a future phase."
                                       Foreground="#D9DDED" TextWrapping="Wrap" Margin="0,12,0,0"/>
                        </StackPanel>
                    </Border>
                    <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                        <Button Content="Start session" IsEnabled="False" Padding="18,10"
                                Background="{StaticResource AccentBrush}" Foreground="White"
                                BorderThickness="0"/>
                        <TextBlock Text="  Audio module coming in Phase 2"
                                   Foreground="{StaticResource SecondaryText}" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Background="{StaticResource PanelBackground}"
                    CornerRadius="18" Padding="22">
                <StackPanel>
                    <TextBlock Text="Workspace" Foreground="{StaticResource PrimaryText}"
                               FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock Text="Prepare before your next interview."
                               Foreground="{StaticResource SecondaryText}" Margin="0,8,0,20"
                               TextWrapping="Wrap"/>
                    <Border Background="#111722" CornerRadius="12" Padding="14" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="RESUME" Foreground="{StaticResource SecondaryText}" FontSize="10"/>
                            <TextBlock Text="No resume uploaded" Foreground="{StaticResource PrimaryText}"
                                       Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#111722" CornerRadius="12" Padding="14">
                        <StackPanel>
                            <TextBlock Text="AI PROVIDER" Foreground="{StaticResource SecondaryText}" FontSize="10"/>
                            <TextBlock Text="Not configured" Foreground="{StaticResource PrimaryText}"
                                       Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>

        <TextBlock Grid.Row="2" Text="CoreDotAI • Early development build"
                   Foreground="{StaticResource SecondaryText}" FontSize="11" Margin="2,18,0,0"/>
    </Grid>
</Window>
