<Window x:Class="CoreDotAI.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CoreDotAI" Height="780" Width="1180"
        MinHeight="680" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackground}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,24">
            <StackPanel>
                <TextBlock Text="CoreDotAI" Foreground="{StaticResource PrimaryText}"
                           FontSize="28" FontWeight="SemiBold"/>
                <TextBlock Text="Your AI-powered interview workspace"
                           Foreground="{StaticResource SecondaryText}" FontSize="13" Margin="0,4,0,0"/>
            </StackPanel>
            <Border DockPanel.Dock="Right" Background="#20283A" CornerRadius="14"
                    Padding="12,7" VerticalAlignment="Center">
                <TextBlock x:Name="HeaderStatusText" Text="● READY" Foreground="#83E0B0"
                           FontSize="11" FontWeight="Bold"/>
            </Border>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource PanelBackground}"
                    CornerRadius="18" Padding="24">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0">
                        <TextBlock Text="Live assistant" Foreground="{StaticResource PrimaryText}"
                                   FontSize="20" FontWeight="SemiBold"/>
                        <TextBlock Text="Capture audio only when you have permission from everyone involved."
                                   Foreground="{StaticResource SecondaryText}" TextWrapping="Wrap"
                                   Margin="0,8,0,18"/>
                    </StackPanel>

                    <Border Grid.Row="1" Background="#111722" CornerRadius="12" Padding="16" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="AUDIO SOURCES" Foreground="{StaticResource SecondaryText}"
                                       FontSize="11" FontWeight="Bold" Margin="0,0,0,10"/>
                            <CheckBox x:Name="MicrophoneCheckBox" Content="Microphone input" IsChecked="True"
                                      Foreground="{StaticResource PrimaryText}" Margin="0,4"/>
                            <CheckBox x:Name="SystemAudioCheckBox" Content="Computer / meeting audio (loopback)"
                                      IsChecked="True" Foreground="{StaticResource PrimaryText}" Margin="0,4"/>
                            <CheckBox x:Name="ConsentCheckBox"
                                      Foreground="#F2C879" Margin="0,12,0,0"
                                      Checked="ConsentCheckBox_Changed" Unchecked="ConsentCheckBox_Changed">
                                <TextBlock Text="I have permission to capture and process this conversation."
                                           TextWrapping="Wrap"/>
                            </CheckBox>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="2" Background="#111722" CornerRadius="12" Padding="18">
                        <StackPanel>
                            <TextBlock Text="SESSION STATUS" Foreground="{StaticResource SecondaryText}"
                                       FontSize="11" FontWeight="Bold"/>
                            <TextBlock x:Name="SessionStatusText" Text="Not recording"
                                       Foreground="{StaticResource PrimaryText}" FontSize="18"
                                       FontWeight="SemiBold" Margin="0,10,0,6"/>
                            <TextBlock x:Name="SessionDetailsText"
                                       Text="Audio files will be saved locally on this computer. Transcription is the next development phase."
                                       Foreground="{StaticResource SecondaryText}" TextWrapping="Wrap"/>
                            <TextBlock x:Name="OutputFolderText" Foreground="#A4AABC"
                                       FontSize="11" TextWrapping="Wrap" Margin="0,14,0,0"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,18,0,0">
                        <Button x:Name="StartButton" Content="Start capture" Click="StartButton_Click"
                                Padding="18,10" Background="{StaticResource AccentBrush}"
                                Foreground="White" BorderThickness="0" IsEnabled="False"/>
                        <Button x:Name="StopButton" Content="Stop capture" Click="StopButton_Click"
                                Padding="18,10" Margin="10,0,0,0" Background="#343B4B"
                                Foreground="White" BorderThickness="0" IsEnabled="False"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="{StaticResource PanelBackground}"
                    CornerRadius="18" Padding="22">
                <StackPanel>
                    <TextBlock Text="Workspace" Foreground="{StaticResource PrimaryText}"
                               FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock Text="Preparation tools will be enabled in upcoming phases."
                               Foreground="{StaticResource SecondaryText}" Margin="0,8,0,20"
                               TextWrapping="Wrap"/>
                    <Border Background="#111722" CornerRadius="12" Padding="14" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="RESUME" Foreground="{StaticResource SecondaryText}" FontSize="10"/>
                            <TextBlock Text="No resume uploaded" Foreground="{StaticResource PrimaryText}"
                                       Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#111722" CornerRadius="12" Padding="14" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="AI PROVIDER" Foreground="{StaticResource SecondaryText}" FontSize="10"/>
                            <TextBlock Text="Not configured" Foreground="{StaticResource PrimaryText}"
                                       Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#20283A" CornerRadius="12" Padding="14">
                        <TextBlock Text="Privacy first: capture is off by default, requires explicit consent, and can be stopped at any time."
                                   Foreground="#C9D0E0" TextWrapping="Wrap" FontSize="12"/>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>

        <TextBlock Grid.Row="2" Text="CoreDotAI • Audio capture foundation"
                   Foreground="{StaticResource SecondaryText}" FontSize="11" Margin="2,18,0,0"/>
    </Grid>
</Window>
