<Application x:Class="CoreDotAI.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="WindowBackground" Color="#10131A" />
        <SolidColorBrush x:Key="PanelBackground" Color="#191E29" />
        <SolidColorBrush x:Key="AccentBrush" Color="#7C6CFF" />
        <SolidColorBrush x:Key="PrimaryText" Color="#F4F5FA" />
        <SolidColorBrush x:Key="SecondaryText" Color="#A4AABC" />
    </Application.Resources>
</Application>
